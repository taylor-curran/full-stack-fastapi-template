{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "lint": "bun run --filter frontend lint",
    "test": "bun run --filter frontend test",
    "test:ui": "bun run --filter frontend test:ui",
    "test:playwright:targeted": "docker compose run --rm playwright bunx playwright test tests/login.spec.ts --project=chromium --grep \"Log In button is visible\"",
    "test:karate:targeted": "cd backend/karate && mvn -q -DapiBaseUrl=http://backend:8000 -Dtest=HealthCheckKarateTest test"
  }
}
